	measure Title = ```
			
			---"SEGMENT MEMBER NEW (+) PROGRAM SPEND  " & 
			    FORMAT(
			        FIRSTNONBLANK('Calendar'[Month-Year], 0),
			        "MMMM yyyy"
			    ) &    "   Segment Member New Supplier Spend"
			```
		lineageTag: e44086c0-0229-4b75-b8d0-bd21af501145

	measure Sales = CALCULATE(SUM('Invoice_Detailed'[APTrxAmt]))
