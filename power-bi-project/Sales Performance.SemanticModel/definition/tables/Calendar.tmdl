	column 'Week Begin'
		formatString: General Date
		lineageTag: 9dfa18ab-d4b6-4e80-83b1-83e05602cc4d
		summarizeBy: none
		isNameInferred
		sourceColumn: [Week Begin]

		variation Variation
			isDefault
			relationship: ab2edc33-627e-4ab9-b85a-f7d9856b3af4
			defaultHierarchy: LocalDateTable_be07a0c7-7339-4d12-9c75-78fd9b8f5d5f.'Date Hierarchy'

		annotation SummarizationSetBy = Automatic

	partition Calendar = calculated
		mode: import
		source = ```
				
				VAR StartDate = MIN('Invoice_Detailed'[MonthStart]) -- Define your static start date here
				VAR EndDate = TODAY()  -- Define your static end date here
				-- Alternatively, use: VAR StartDate = MIN('Sales'[OrderDate]) to make it dynamic
				
				RETURN
				ADDCOLUMNS (
				    CALENDAR ( StartDate, EndDate ),
				    "Year", YEAR ( [Date] ),
				    "Quarter Number", QUARTER ( [Date] ),
				    "Quarter", "Q" & FORMAT ( [Date], "Q" ),
				    "Month Number", MONTH ( [Date] ),
				    "Month Name", FORMAT ( [Date], "mmmm" ),
				    "Month Short", FORMAT ( [Date], "mmm" ),
				    "Month-Year", FORMAT ( [Date], "mmm-yyyy" ),
				    "Month-Year Sort", YEAR ( [Date] ) * 100 + MONTH ( [Date] ),
				    "Week Number", WEEKNUM ( [Date], 2 ),
				    "Day of Month", DAY ( [Date] ),
				    "Day Name", FORMAT ( [Date], "dddd" ),
				    "Day of Week Number", WEEKDAY ( [Date], 2 ),
				    "Week Begin", [Date] - WEEKDAY([Date],2) + 1
				)
				
				```

	annotation PBI_Id = f86173a2491647fd86668140cec0da69

