				    #"Added Year" = Table.AddColumn(#"Added MonthNo", "Year", each Text.From(Date.Year([MonthStart])), type text),
				    #"Added Year-Month" = Table.AddColumn(#"Added Year", "Year-Month", each Date.ToText([MonthStart], "yyyy-MM"), type text),
