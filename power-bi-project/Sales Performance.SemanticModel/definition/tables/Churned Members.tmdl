table 'Churned Members'
	lineageTag: f39bc250-ad88-4c4d-8a12-2273e5b0ca00

	column ParentID
		dataType: int64
		formatString: 0
		lineageTag: 7c05872d-4c12-4073-8156-b4f7ad928b06
		summarizeBy: none
		sourceColumn: ParentID

		annotation SummarizationSetBy = Automatic

	column MaxTerminationDate
		dataType: dateTime
		formatString: Long Date
		lineageTag: 9e8dfaa3-a56b-4de2-bdf8-6942d09eae76
		summarizeBy: none
		sourceColumn: MaxTerminationDate

		variation Variation
			isDefault
			relationship: e6e988d6-6a53-49f7-a9db-e8583d950a12
			defaultHierarchy: LocalDateTable_97c001ed-392e-411f-988c-7c79e24f7a23.'Date Hierarchy'

		annotation SummarizationSetBy = Automatic

		annotation UnderlyingDateTimeDataType = Date

	column 12MonthPurchases =
			
			VAR TermDate =
			    MAX ( 'Churned Members'[MaxTerminationDate] )
			VAR StartDate =
			    EDATE ( TermDate, -12 )
			
			RETURN
			CALCULATE (
			    SUM ( 'Invoice_Detailed'[APTrxAmt] ),
			    FILTER (
			        ALL ( 'Invoice_Detailed'[MonthStart] ),
			        'Invoice_Detailed'[MonthStart] > StartDate
			            && 'Invoice_Detailed'[MonthStart] <= TermDate
			    )
			)
		formatString: \$#,0.###############;(\$#,0.###############);\$#,0.###############
		lineageTag: 4cef0641-903b-4dfd-8458-f4ed9c65a801
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

	column MonthlyAVG = [12MonthPurchases] / 12
		formatString: \$#,0;(\$#,0);\$#,0
		lineageTag: a5571f2b-d1c4-4e5f-b2a8-412043ece743
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

	column Region
		dataType: string
		lineageTag: 417da347-e6bc-4e4d-9d7c-30eda8f54968
		summarizeBy: none
		sourceColumn: Region

		annotation SummarizationSetBy = Automatic

	column Territory
		dataType: string
		lineageTag: 544accd0-b3f1-40cd-a41d-8f27ce59e961
		summarizeBy: none
		sourceColumn: Territory

		annotation SummarizationSetBy = Automatic

	column RemainingMonths
		dataType: string
		lineageTag: 1c749970-ec06-4e61-9830-91c3848e7e62
		summarizeBy: none
		sourceColumn: RemainingMonths

		annotation SummarizationSetBy = Automatic

	column YearsChurn = -[MonthlyAVG] * [RemainingMonths]
		formatString: \$#,0;(\$#,0);\$#,0
		lineageTag: 9ddf19e3-7353-4148-bdb5-f28387bab1e4
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

