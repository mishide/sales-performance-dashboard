table Invoice_Detailed
	lineageTag: 529249ad-ad70-450d-b09e-817aadcedd6c

	measure 'YTD Total Billings' =
			
			ROUND(
			    CALCULATE(
			        SUM('Invoice_Detailed'[Billings US])
			        ,USERELATIONSHIP(
			            'FirstInvoiceDate'[bt_bf_key],'Invoice_Detailed'[bt_bf_key]
			        )
			),0)
		formatString: \$#,0.###############;(\$#,0.###############);\$#,0.###############
		lineageTag: 9fed136e-3b72-4662-87b9-a4d2a96f2468

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

	measure 'First Month Billings' =
			
			
			ROUND(
			    SUMX(
			        'Calendar',
			        var FirstMonth = 'Calendar'[Date]
			    RETURN
			        CALCULATE(
			            SUM('Invoice_Detailed'[Billings US])
			            ,'Invoice_Detailed'[MonthStart] = FirstMonth
			            ,USERELATIONSHIP(
			            'FirstInvoiceDate'[bt_bf_key],'Invoice_Detailed'[bt_bf_key]
			        )
			        )
			),0)
		formatString: \$#,0.###############;(\$#,0.###############);\$#,0.###############
		lineageTag: 01697712-cf2e-4eec-a592-bd91ec58ca9d

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

	measure 'Cumulative Billings' =
			
			VAR CurrentWeek =
			    MAX('Invoice_Detailed'[MonthStart])
			
			RETURN
			CALCULATE(
			    SUM('Invoice_Detailed'[Billings US]),
			    FILTER(
			        ALL('Invoice_Detailed'[MonthStart])
			        ,'Invoice_Detailed'[MonthStart] <= CurrentWeek
			    )
			)
		formatString: \$#,0.###############;(\$#,0.###############);\$#,0.###############
		lineageTag: 9d44ad11-492d-4681-aab1-267b763f49a6

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

	measure 'New Logo Billings' =
			
			CALCULATE(
			    SUM(Invoice_Detailed[Billings US]),
			    Invoice_Detailed[LabelChurn] = "New Logo"
			)
		formatString: \$#,0;(\$#,0);\$#,0
		lineageTag: 38df3557-e0fc-454a-bb2f-74312697fb5a

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

	measure 'Expansion Billings' =
			
			CALCULATE(
			    SUM(Invoice_Detailed[Billings US]),
			    Invoice_Detailed[LabelChurn] = "Expansion"
			)
		formatString: \$#,0;(\$#,0);\$#,0
		lineageTag: cb27715f-348e-4466-9a2f-2b4c738f2e57

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

	measure 'Churn Billings Card' =
			
			var a = CALCULATE(
			    SUM(Invoice_Detailed[Billings US]),
			    Invoice_Detailed[LabelChurn] = "Churn"
			)
			RETURN IF(ISBLANK(a), 0, a)
		formatString: \$#,0;(\$#,0);\$#,0
		lineageTag: ccd15a66-d6e7-4cfb-a1cd-7d7f9bb05648

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

	measure '2025 New Billings' =
			
			VAR CurrentMonth =
			    SELECTEDVALUE('Calendar'[Month Number])
			RETURN
			CALCULATE(
			    [Expansion Billings] + [New Logo Billings],
			    FILTER(
			        ALL('Calendar'),
			        'Calendar'[Year] = 2025
			            && 'Calendar'[Month Number] <= CurrentMonth
			    )
			)
		formatString: \$#,0.###############;(\$#,0.###############);\$#,0.###############
		lineageTag: 72c61f82-20b9-4b02-8c34-1111c570905c

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

	measure '2026 New Billings' =
			
			CALCULATE(
			    [Expansion Billings] + [New Logo Billings],
			    FILTER(
			        ALL('Calendar'),
			        'Calendar'[Year] = 2026 &&
			        'Calendar'[Date] <= MAX('Calendar'[Date])
			    )
			)
		formatString: \$#,0.###############;(\$#,0.###############);\$#,0.###############
		lineageTag: 6b2b5ece-318e-4c3f-a764-67d9ee690ecf

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

	measure 'Churn Billings' =
			
			CALCULATE(
			    SUM(Invoice_Detailed[Billings US]),
			    Invoice_Detailed[LabelChurn] = "Churn"
			)
		formatString: \$#,0;(\$#,0);\$#,0
		lineageTag: c857af09-a553-42c2-be8b-1cf05a285577

	measure 'Churn Programs' = "TBD"
		lineageTag: 86ce8583-692d-4fd7-858c-c291f5d6b7c3

	measure '2025 Cohort Cumulative Billings' =
			
			VAR CurrentDate =
			    MAX ( 'Calendar'[Date] )
			
			-- Bill-to/bill-for relationships with new logo or expansion billings in 2025
			VAR Cohort2025 =
			    CALCULATETABLE (
			        FILTER (
			            VALUES ( Invoice_Detailed[bt_bf_key] ),
			            [Expansion Billings] + [New Logo Billings] > 0
			        ),
			        ALL ( 'Calendar' ),
			        'Calendar'[Year] = 2025
			    )
			
			-- 2025 portion: new logo + expansion only
			VAR NewBillings2025 =
			    CALCULATE (
			        [Expansion Billings] + [New Logo Billings],
			        ALL ( 'Calendar' ),
			        'Calendar'[Date] >= DATE ( 2025, 1, 1 ),
			        'Calendar'[Date] <= MIN ( CurrentDate, DATE ( 2025, 12, 31 ) ),
			        Cohort2025
			    )
			
			-- 2026+ portion: all billings from the cohort
			VAR AllBillings2026 =
			    IF (
			        CurrentDate >= DATE ( 2026, 1, 1 ),
			        CALCULATE (
			            [YTD Billings Total],   -- replace with your total billings measure
			            ALL ( 'Calendar' ),
			            'Calendar'[Date] >= DATE ( 2026, 1, 1 ),
			            'Calendar'[Date] <= CurrentDate,
			            Cohort2025
			        ),
			        0
			    )
			
			RETURN
			    IF ( CurrentDate <= EOMONTH ( TODAY (), 0 ), NewBillings2025 + AllBillings2026 )
		formatString: \$#,0.###############;(\$#,0.###############);\$#,0.###############
		lineageTag: 3fd4abd8-33ae-482e-97df-8775cfa31d49

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

	measure 'YTD Billings Total' = SUM('Invoice_Detailed'[Billings US])
		formatString: \$#,0.###############;(\$#,0.###############);\$#,0.###############
		lineageTag: ca371866-162a-4f00-a607-95a0eb5dee55

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

	measure '2026 Cohort Cumulative Billings' =
			
			VAR CurrentDate =
			    MAX ( 'Calendar'[Date] )
			
			-- Bill-to/bill-for relationships with new logo or expansion billings in 2025
			VAR Cohort2025 =
			    CALCULATETABLE (
			        FILTER (
			            VALUES ( Invoice_Detailed[bt_bf_key] ),
			            [Expansion Billings] + [New Logo Billings] > 0
			        ),
			        ALL ( 'Calendar' ),
			        'Calendar'[Year] = 2026
			    )
			
			-- 2025 portion: new logo + expansion only
			VAR NewBillings2026 =
			    CALCULATE (
			        [Expansion Billings] + [New Logo Billings],
			        ALL ( 'Calendar' ),
			        'Calendar'[Date] >= DATE ( 2026, 1, 1 ),
			        'Calendar'[Date] <= MIN ( CurrentDate, DATE ( 2026, 12, 31 ) ),
			        Cohort2025
			    )
			
			
			RETURN
			    IF ( CurrentDate <= EOMONTH ( TODAY (), 0 ), NewBillings2026 )
		formatString: \$#,0.###############;(\$#,0.###############);\$#,0.###############
		lineageTag: 2adf7443-aa55-4206-a865-8c1ff704e0ca

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

	measure Headline =
			
			VAR Gross =  [Gross New 2025]
			VAR Churn = ABS ( COALESCE ( [Churn Billings 2025], 0 ) )
			VAR Net   = Gross - Churn
			VAR Pct   = DIVIDE ( Churn, Gross )
			VAR Cum   = [2025 Cohort Cumulative Billings]
			VAR YTD26 = Cum - Gross
			RETURN
			"In 2025 Sales added " & FORMAT ( Gross / 1000000, "$0.0" ) & "M in new billings; churn removed "
			& FORMAT ( Churn / 1000000, "$0.0" ) & "M (" & FORMAT ( Pct, "0%" ) & " of New), leaving "
			& FORMAT ( Net / 1000000, "$0.0" ) & "M net.  "
			& "These 2025 new cohorts have generated an additional "
			& FORMAT ( YTD26 / 1000000, "$0.0" ) & "M in billings in 2026 YTD."
		lineageTag: 8905adaa-63dc-41b4-83a7-645383f19a82

	measure 'Gross New' = [2025 New Billings]
		formatString: \$#,0.###############;(\$#,0.###############);\$#,0.###############
		lineageTag: 32f16da6-756e-43ac-8d49-1b2b0dd7584b

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

	measure 'Churn Billings 2025' =
			
			CALCULATE ( [Churn Billings], 'Calendar'[Year] = 2025 )
		formatString: \$#,0.###############;(\$#,0.###############);\$#,0.###############
		lineageTag: 289380e5-3c4f-4a69-987a-eb65a3885b60

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

	measure 'Gross New 2025' =
			
			CALCULATE ( [New Logo Billings] + [Expansion Billings], 'Calendar'[Year] = 2025 )
		formatString: \$#,0.###############;(\$#,0.###############);\$#,0.###############
		isHidden
		lineageTag: 78908496-c0d0-49d9-9b67-dc37657a96bc

		changedProperty = IsHidden

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

	measure '2025 Year-End Total' =
			
			VAR IsYE =
			    MAX ( 'Calendar'[Year] ) = 2025
			    && MAX ( 'Calendar'[Month Number] ) = 12
			RETURN
			    IF ( IsYE, [2025 Cohort Cumulative Billings] )
		formatString: \$#,0.0;(\$#,0.0);\$#,0.0
		lineageTag: 6c2045f7-3d55-4533-bcc6-41d8e34027a4

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

	measure 'New YTD Label' = FORMAT ( [2025 Year-End Total] / 1000000, "$0.0" ) & "2025"
		lineageTag: 2afee04c-6f96-4d8a-aeaf-c8f4aead52b7

